   sqrt(c)/(n*sqrt(b^2-4*a*c)*sqrt(b-sqrt(b^2-4*a*c)))-2*atan(x^(1/2*n)*_
   sqrt(2)*sqrt(c)/sqrt(b+sqrt(b^2-4*a*c)))*sqrt(2)*sqrt(c)/_
   (n*sqrt(b^2-4*a*c)*sqrt(b+sqrt(b^2-4*a*c)))
