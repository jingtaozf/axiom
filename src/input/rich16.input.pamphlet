--S 1197 of 2282
r0:=-c^(1/4)*atan(2^(1/4)*c^(1/4)*x/(-b-sqrt(b^2-4*a*c))^(1/4))/(2^(3/4)*_
   (-b-sqrt(b^2-4*a*c))^(1/4)*sqrt(b^2-4*a*c))+c^(1/4)*_
   atanh(2^(1/4)*c^(1/4)*x/(-b-sqrt(b^2-4*a*c))^(1/4))/(2^(3/4)*_
   (-b-sqrt(b^2-4*a*c))^(1/4)*sqrt(b^2-4*a*c))+c^(1/4)*atan(2^(1/4)*_
   c^(1/4)*x/(-b+sqrt(b^2-4*a*c))^(1/4))/(2^(3/4)*sqrt(b^2-4*a*c)*_
   (-b+sqrt(b^2-4*a*c))^(1/4))-c^(1/4)*atanh(2^(1/4)*c^(1/4)*x/_
   (-b+sqrt(b^2-4*a*c))^(1/4))/(2^(3/4)*sqrt(b^2-4*a*c)*_
   (-b+sqrt(b^2-4*a*c))^(1/4))
