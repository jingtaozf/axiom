--S 866 of 2282
t0:=x^3/(1-x^3+x^6)
--R 
--R
--R              3
--R             x
--R   (1)  -----------
--R         6    3
--R        x  - x  + 1
--R                                          Type: Fraction(Polynomial(Integer))
--E 866

--S 867 of 2282
r0:=1/3*atan((4*x+2^(2/3)*(1+%i*sqrt(3))^(1/3))/(2^(2/3)*(1+%i*_
   sqrt(3))^(1/3)*sqrt(3)))*(%i-sqrt(3))/(2^(1/3)*(1+%i*sqrt(3))^(2/3))+_
