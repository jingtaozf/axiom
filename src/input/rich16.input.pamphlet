--S 1981 of 2282
r0:=-4*2^(1/4)*c^(5/4)*atan(2^(1/4)*c^(1/4)*x^(1/4*n)/_
   (-b-sqrt(b^2-4*a*c))^(1/4))/(n*(-b-sqrt(b^2-4*a*c))^(5/4)*_
   sqrt(b^2-4*a*c))+4*2^(1/4)*c^(5/4)*atanh(2^(1/4)*c^(1/4)*x^(1/4*n)/_
   (-b-sqrt(b^2-4*a*c))^(1/4))/(n*(-b-sqrt(b^2-4*a*c))^(5/4)*_
   sqrt(b^2-4*a*c))+4*2^(1/4)*c^(5/4)*atan(2^(1/4)*c^(1/4)*x^(1/4*n)/_
   (-b+sqrt(b^2-4*a*c))^(1/4))/(n*sqrt(b^2-4*a*c)*_
   (-b+sqrt(b^2-4*a*c))^(5/4))-4*2^(1/4)*c^(5/4)*atanh(2^(1/4)*_
   c^(1/4)*x^(1/4*n)/(-b+sqrt(b^2-4*a*c))^(1/4))/(n*sqrt(b^2-4*a*c)*_
   (-b+sqrt(b^2-4*a*c))^(5/4))+8*c/(n*x^(1/4*n)*(b^2-4*a*c-_
   b*sqrt(b^2-4*a*c)))+8*c/(n*x^(1/4*n)*(b^2-4*a*c+b*sqrt(b^2-4*a*c)))
