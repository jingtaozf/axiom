   4*a*c))^(1/4))+1/2*atanh(2^(1/4)*c^(1/4)*x/(-b-sqrt(b^2-_
   4*a*c))^(1/4))*(b+(b^2-2*a*c)/sqrt(b^2-4*a*c))/(2^(3/4)*c^(7/4)*_
   (-b-sqrt(b^2-4*a*c))^(1/4))-1/2*atan(2^(1/4)*c^(1/4)*x/(-b+_
   sqrt(b^2-4*a*c))^(1/4))*(b+(-b^2+2*a*c)/sqrt(b^2-4*a*c))/(2^(3/4)*_
   c^(7/4)*(-b+sqrt(b^2-4*a*c))^(1/4))+1/2*atanh(2^(1/4)*c^(1/4)*_
   x/(-b+sqrt(b^2-4*a*c))^(1/4))*(b+(-b^2+2*a*c)/sqrt(b^2-4*a*c))/(2^(3/4)*_
   c^(7/4)*(-b+sqrt(b^2-4*a*c))^(1/4))
