#!/bin/sh
# srctangle ORGFILE [CHUNK] -- extract source code from a migrated .org file,
# writing it to stdout.  The single tangle entry point the build uses for every
# source extraction (replacing the historical tanglec / lisp `tangle' calls).
#
#   default              org -> source DIRECTLY, via the orgtangle C tool; no
#                        .pamphlet is ever written.  This is the migrated path.
#
#   AXIOM_TANGLE_VIA_PAMPHLET=1
#                        the original org -> pamphlet -> source path: regenerate
#                        the exact .pamphlet beside the .org (untanglec) and tangle
#                        THAT with the reference C tanglec.  Kept off by default
#                        but available so a build (or the E2E test) can prove the
#                        two paths emit byte-identical source.
#
# orgtangle == tanglec(untanglec(org)) == the Lisp `tangle' are all byte-identical
# (verified over every chunk of every file), so either path yields the same build.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
org=$1
chunk=${2:-*}
if [ "${AXIOM_TANGLE_VIA_PAMPHLET:-0}" = 1 ]; then
  pam=${org%.org}.pamphlet
  "$here/untanglec" "$org" > "$pam" || exit $?
  exec "$here/tanglec" "$pam" "$chunk"
else
  exec "$here/orgtangle" "$org" "$chunk"
fi
