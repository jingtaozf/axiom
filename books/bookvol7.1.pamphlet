\pastebutton{ugGraphTwoDappendPageFull1}{\hidepaste}
\tab{5}\spadcommand{v1 := draw(sin(x),x=0..2*\%pi)\bound{v1 }}
\indentrel{3}\begin{verbatim}
   (1)  TwoDimensionalViewport: "sin x"
                           Type: TwoDimensionalViewport
\end{verbatim}
