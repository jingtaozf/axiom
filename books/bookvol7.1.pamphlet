\pastebutton{ugGraphThreeDPlotPageFull2}{\hidepaste}
\tab{5}\spadcommand{f(x,y) == sin(x)*cos(y)\bound{f }}
\indentrel{3}\begin{verbatim}
                                             Type: Void
\end{verbatim}
\indentrel{-3}\end{paste}\end{patch}

