\indentrel{3}\begin{verbatim}
   (2)  [0.0,1.0]
                                Type: Point DoubleFloat
\end{verbatim}
\indentrel{-3}\end{paste}\end{patch}

\begin{patch}{ListPointsGraphicsExamplePageEmpty2}
