              9        6       3
       (- 960y  + 2160y  - 180y  - 3)cos(x)sin(x)
     + 
             9        6       3
       (3840y  - 8640y  + 720y  + 12)cos(x)
  /
            12        9        6       3      +---+
       (256y   - 1792y  + 1120y  - 112y  + 1)\|- y
     + 
              11        8       5      2
       - 1024y   + 1792y  - 448y  + 16y
                               Type: Expression Integer
\end{verbatim}
\indentrel{-3}\end{paste}\end{patch}

