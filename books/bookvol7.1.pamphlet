\indentrel{3}\begin{verbatim}
        +21   37   53   14 +
        |                  |
        |8   - 24  22  - 16|
   (7)  |                  |
        |2    10   15   14 |
        |                  |
        +26   33   55  - 13+
                                   Type: Matrix Integer
\end{verbatim}
\indentrel{-3}\end{paste}\end{patch}

