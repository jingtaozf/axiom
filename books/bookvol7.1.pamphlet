\indentrel{3}\begin{verbatim}
        +  2        5 +
        |- -  - 1   - |
        |  7        7 |
        |             |
   (1)  | 8          6|
        | -    1   - -|
        | 7          7|
        |             |
        +- 1  - 1   1 +
               Type: Union(Matrix Fraction Integer,...)
\end{verbatim}
\indentrel{-3}\end{paste}\end{patch}

\begin{patch}{ExInverseMatrixEmpty1}
