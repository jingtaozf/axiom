{\tt 10.\ \ }\newline
{\tt 11.\ \ )read\ ribbonsnew}\newline
{\tt 12.\ \ drawRibbons([x**i\ for\ i\ in\ 1..5],\ x=-1..1,\ y=0..2)}\newline
  
\noindent


%\input{gallery/conformal.htex}
\endscroll
