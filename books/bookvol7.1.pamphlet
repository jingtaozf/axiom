\begin{paste}{HTXFormatPage8xPaste1A}{HTXFormatPage8xPatch1A}
\pastebutton{HTXFormatPage8xPaste1A}{Source}
\newline
\inputbitmap{\env{AXIOM}/doc/bitmaps/sup.bitmap}
\end{paste}
\end{patch}
