    [1,0,%A + 1,0,1,1,%A,%A],
    [0,0,%A + 1,%A + 1,%A + 1,1,1,%A], [0,0,1,0,0,1,0,1],
    [0,%A,0,%A,1,%A + 1,%A + 1,%A]]
     ]
                     Type: List Matrix FiniteField(2,2)
\end{verbatim}
\indentrel{-3}\end{paste}\end{patch}

