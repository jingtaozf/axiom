\indentrel{3}\begin{verbatim}
   (1)  0.20000000000000001
                                      Type: DoubleFloat
   (2)  2.8274333882308138
                                      Type: DoubleFloat
                                             Type: Void
                                             Type: Void
\end{verbatim}
\indentrel{-3}\end{paste}\end{patch}

