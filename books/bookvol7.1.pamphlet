\tab{5}\spadcommand{m2 := m1 :: SquareMatrix(2,FRAC POLY COMPLEX INT)\free{m1 }\bound{m2 }}
\indentrel{3}\begin{verbatim}
        +               2     +
        | 4x - 3%i    2y z + 1|
        | --------    --------|
        |     4           2   |
   (6)  |                     |
        |     4               |
        |3%i y  - 7x  60 - 9%i|
        |-----------  --------|
        +     7           5   +
Type: SquareMatrix(2,Fraction Polynomial Complex Integer)
\end{verbatim}
\indentrel{-3}\end{paste}\end{patch}

