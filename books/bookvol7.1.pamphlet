      SUBROUTINE FCNF(X,F)
      DOUBLE PRECISION X
      DOUBLE PRECISION F(2,2)
      F(1,1)=0.0D0
      F(1,2)=1.0D0
      F(2,1)=0.0D0
      F(2,2)=-10.0D0
      RETURN
      END
\end{verbatim}
\end{page}

