        +     3%i     2    1 +
        | x - ---    y z + - |
        |      4           2 |
   (5)  |                    |
        |3%i  4      60 - 9%i|
        |--- y  - x  --------|
        + 7              5   +
Type: SquareMatrix(2,Polynomial Fraction Complex Integer)
\end{verbatim}
\indentrel{-3}\end{paste}\end{patch}

