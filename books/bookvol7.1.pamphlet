\pastebutton{HTXFormatPage7xPaste2B}{Interpret}
\newline
{\tt x\\hspace\{-4\}x\\hspace\{-3\}x\\hspace\{-2\}x\\hspace\{-1\}x\%}
\newline
{\tt x\\hspace\{1\}x\\hspace\{2\}x\\hspace\{3\}x\\hspace\{4\}x}
\end{paste}
\end{patch}

\end{chunk}
\subsection{HTXFormatPage7xPatch3 patch}
