\pastebutton{ugxProblemOnePolPageFull1}{\hidepaste}
\tab{5}\spadcommand{solve(x**3 = 8,x)}
\indentrel{3}\begin{verbatim}
               2
   (1)  [x= 2,x  + 2x + 4= 0]
