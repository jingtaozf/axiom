\subsection{示例}

\chapter{Lazard/Rioboo/Trager 改进}
\cite{Gedd92} p 506\\
{\bf procedure} LogarithmicPartIntegral$(a,b,x)$
\begin{addmargin}{1em}
-- 给定 $x$ 中的有理函数 $a/b$,满足 deg($a$) $<$ deg($b$)\\
-- $b$ 首一 (monic) 且无平方因子,我们计算 $\int a/b$\\
-- 计算(借助次结式 (subresultant) 算法)\\
$R(z) = \textrm{res}_x(a-z\cdot b^\prime,b)$\\
$S_i(x,z) =$ 此次计算中 $x$ 的次数为 $i$ 的余式\\
$(R_1(x),\ldots,R_k(z)) \leftarrow \textrm{SquareFree}(R(z))$\\
-- 处理 $R(z)$ 中的非平凡无平方因子\\
integral $\leftarrow 0$\\
{\bf for} $i$ {\bf from} 1 {\bf to} $k$ {\bf with} $R_i(z)\ne 1$ {\bf do} \{
\begin{addmargin}{1em}
-- 归一化使结果首一\\
$w(z) = \textrm{lcoeff}_x(S_i(x,z))$\\
$EEA(w(z),R_i(z); s(z),t(z))$\\
$S_i(x,z)= \textrm{pp}_z(\textrm{rem}(s(z)\cdot S_i(x,z),R_i(z)))$\\
-- 将 $S_i(x,c)$(其中 $c$ 为 $R_i(z)$ 的一个根)转换为更简单的形式\\
-- (参见 \cite{Gedd92} p 499 的 LogarithmicPartIntegral)\\
$(r_{i,1},\ldots,r_{i,k_i}) \leftarrow \textrm{factors}(R_i(z))$\\
{\bf for} $j$ {\bf from} 1 {\bf to} $k_i$ {\bf do} \{
\begin{addmargin}{1em}
$d_j \leftarrow \textrm{deg}_z(r_{i,j}(z))$\\
{\bf if} $d_j=1$ {\bf then} \{
\begin{addmargin}{1em}
$c \leftarrow \textrm{solve}(r_{i,j}(z)=0,z)$\\
integral $\leftarrow$ integral$+c\cdot \textrm{log}(S_i(x,c))\}$
\end{addmargin}
{\bf elseif} $d_j=2$ {\bf then} \{ -- 用根式给出答案\\
\begin{addmargin}{1em}
$c \leftarrow \textrm{solve}(r_{i,j}(z)=0,z)$\\
{\bf for} $n$ {\bf from} 1 {\bf to} 2 {\bf do} \{
\begin{addmargin}{1em}
integral $\leftarrow$ integral$+c[n]\cdot \textrm{log}(S_i(x,c[n]))$ \}\}
\end{addmargin}
\end{addmargin}
{\bf else} \{ -- 需要用 RootOf 记法给出答案
\begin{addmargin}{1em}
{\bf for} $n$ {\bf from} 1 {\bf to} $d_j$ {\bf do} \{
\begin{addmargin}{1em}
integral $\leftarrow$ integral+$c[n]\cdot\textrm{log}(S_i(x,c[n]))$\\
--\quad(其中 $c[n]=\textrm{RootOf}(r_{i,j}(z)))$ \}\}\}\}
\end{addmargin}
\end{addmargin}
\end{addmargin}
\end{addmargin}
{\bf return}(integral)
\end{addmargin}
{\bf end}

