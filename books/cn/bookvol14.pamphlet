\subsection{示例}

\chapter{幂级数求逆的 Newton 方法}

\cite{Gedd92} p 140\\
{\bf procedure} FastNewtonInversion$(a(x),n)$\\
\begin{addmargin}{1em}
-- 给定 $x$ 中的幂级数 $a(x)$,满足 $a(0) = a_0 \ne 0$\\
-- 求幂级数 $1/a(x)$ 的前 $2^n$ 项。\\
$y \leftarrow 1/a_0$\\
{\bf for} $k$ {\bf from} 0 {\bf to} $n-1$ {\bf do}
\begin{addmargin}{1em}
$y \leftarrow y\cdot (2-y\cdot a(x)) \textrm{ mod } x^{2^{k+1}}$
\end{addmargin}
{\bf return}($y$)
\end{addmargin}
{\bf end}

\subsection{背景}

\subsection{示例}

\chapter{求解 $P(y)=0$ 的 Newton 方法}
\cite{Gedd92} p 144\\
{\bf procedure} NewtonSolve$(P(y),y_0,n)$
\begin{addmargin}{1em}
-- 给定 $P(y) \in \textrm{F}[[x]][y]$,以及满足下式的一点 $y_0$\\
-- $P(y_0)=0 \textrm{ mod }x$ 且 $P^\prime(y_0) \ne 0$,我们通过\\
-- Newton 方法求出 $P(y)=0$ 的解的前 $2^n$ 项\\
$y \leftarrow y_0$\\
{\bf for} $k$ {\bf from} 0 {\bf to} $n-1$ {\bf do}
\begin{addmargin}{1em}
$y \leftarrow y-(P(y)\cdot P^\prime(y)^-1\textrm{ mod }x^{2^{k+1}}$
\end{addmargin}
{\bf return}$(y)$
\end{addmargin}
{\bf end}

