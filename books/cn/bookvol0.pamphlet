\right]
$$
\returnType{Type: List List RealClosure Fraction Integer}

我们得到了 24 个点,以 {\bf R} 的 {\tt Fraction} 的
{\tt RealClosure} 中元素构成的列表来给出。在每个列表中,第一个
值对应不定元 {\bf f},第二个对应 {\bf e},依此类推。关于
\spadfunFrom{realSolve}{ZeroDimensionalSolvePackage} 操作的
更多信息,参见 {\tt ZeroDimensionalSolvePackage}。

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\domainhead{LazardSetSolvingPackage}

{\tt LazardSetSolvingPackage} package 构造子通过 Lazard 三角
集来求解多项式系统。不过,有一个条件被放宽了:饱和理想
(saturated ideal) 维数为正的正则三角集,不必是规范化的。

分解分两步计算。首先调用 Moreno Maza 的算法(实现于
{\tt RegularTriangularSet} domain 构造子中)。然后把得到的分解
转换为无平方因子正则三角集的列表,并移除冗余的分量。此外,
零维的正则三角集会被规范化。

注意,理解三角分解的方式,在 {\tt RegularTriangularSet}
构造子的示例中有详细说明。

{\tt LazardSetSolvingPackage} 构造子接受六个实参。第一个,
{\bf R},是多项式的系数环;它必须属于 {\tt GcdDomain} category。
第二个,{\bf E},是多项式的指数幺半群;它必须属于
{\tt OrderedAbelianMonoidSup} category。第三个,{\bf V},是变量
的全序集;它必须属于 {\tt OrderedSet} category。第四个是多项式
环;它必须属于 {\tt RecursivePolynomialCategory(R,E,V)}
category。第五个是 {\tt RegularTriangularSetCategory(R,E,V,P)}
category 的一个 domain,最后一个是
{\tt SquareFreeRegularTriangularSetCategory(R,E,V,P)} category
的一个 domain。{\tt LazardSetSolvingPackage} 的缩写是
{\tt LAZM3PK}。

{\bf 注意}:关于求解零维代数系统这一目的,另请参见\\
{\tt LexTriangular\-Package} 与
{\tt ZeroDimensionalSolvePackage}。这些 package 比
{\tt LAZM3PK} 更容易调用。此外,{\tt ZeroDimensionalSolvePackage}
package 提供了计算复根或实根的操作。

我们现在用两个例子(Butcher 与 Vermeer)来说明
{\tt LazardSetSolvingPackage} package 构造子的用法。

定义系数环。

\spadcommand{R := Integer}
$$
Integer 
$$
\returnType{Type: Domain}

定义变量列表,

\spadcommand{ls : List Symbol := [b1,x,y,z,t,v,u,w] }
$$
\left[
b1, x, y, z, t, v, u, w 
\right]
$$
\returnType{Type: List Symbol}

并把它做成一个全序集:

\spadcommand{V := OVAR(ls)}
$$
\mbox{\rm OrderedVariableList [b1,x,y,z,t,v,u,w]} 
$$
\returnType{Type: Domain}

然后定义指数幺半群。

\spadcommand{E := IndexedExponents V  }
$$
\mbox{\rm IndexedExponents OrderedVariableList [b1,x,y,z,t,v,u,w]} 
$$
\returnType{Type: Domain}

定义多项式环。

\spadcommand{P := NSMP(R, V)}
$$
\begin{array}{@{}l}
{\rm NewSparseMultivariatePolynomial(Integer,}
\\
\displaystyle
{\rm \ \ OrderedVariableList [b1,x,y,z,t,v,u,w])} 
\end{array}
$$
\returnType{Type: Domain}

把这些变量当作多项式。

\spadcommand{b1: P := 'b1}
$$
b1 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{x: P := 'x  }
$$
x 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{y: P := 'y  }
$$
y 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{z: P := 'z}
$$
z 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{t: P := 't}
$$
t 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{u: P := 'u}
$$
u 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{v: P := 'v}
$$
v 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{w: P := 'w}
$$
w 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

现在调用 {\tt RegularTriangularSet} domain 构造子。

\spadcommand{T := REGSET(R,E,V,P)}
$$
\begin{array}{@{}l}
{\rm RegularTriangularSet(Integer,}
\\
\displaystyle
{\rm \ \ IndexedExponents OrderedVariableList [b1,x,y,z,t,v,u,w],}
\\
\displaystyle
{\rm \ \ OrderedVariableList [b1,x,y,z,t,v,u,w],}
\\
\displaystyle
{\rm \ \ NewSparseMultivariatePolynomial(Integer,}
\\
\displaystyle
{\rm \ \ OrderedVariableList[b1,x,y,z,t,v,u,w]))}
\end{array}
$$
\returnType{Type: Domain}

定义一个多项式系统(Butcher 例子)。

\spadcommand{p0 := b1 + y + z - t - w}
$$
b1+y+z -t -w 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{p1 := 2*z*u + 2*y*v + 2*t*w - 2*w**2 - w - 1}
$$
{2 \  v \  y}+{2 \  u \  z}+{2 \  w \  t} -{2 \  {w \sp 2}} -w -1 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{p2 := 3*z*u**2 + 3*y*v**2 - 3*t*w**2 + 3*w**3 + 3*w**2 - t + 4*w}
$$
{3 \  {v \sp 2} \  y}+{3 \  {u \sp 2} \  z}+{{\left( -{3 \  {w \sp 2}} -1 
\right)}
\  t}+{3 \  {w \sp 3}}+{3 \  {w \sp 2}}+{4 \  w} 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{p3 := 6*x*z*v - 6*t*w**2 + 6*w**3 - 3*t*w + 6*w**2 - t + 4*w}
$$
{6 \  v \  z \  x}+{{\left( -{6 \  {w \sp 2}} -{3 \  w} -1 
\right)}
\  t}+{6 \  {w \sp 3}}+{6 \  {w \sp 2}}+{4 \  w} 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{p4 := 4*z*u**3+ 4*y*v**3+ 4*t*w**3- 4*w**4 - 6*w**3+ 4*t*w- 10*w**2- w- 1}
$$
{4 \  {v \sp 3} \  y}+{4 \  {u \sp 3} \  z}+{{\left( {4 \  {w \sp 3}}+{4 \  
w} 
\right)}
\  t} -{4 \  {w \sp 4}} -{6 \  {w \sp 3}} -{{10} \  {w \sp 2}} -w -1 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{p5 := 8*x*z*u*v +8*t*w**3 -8*w**4 +4*t*w**2 -12*w**3 +4*t*w -14*w**2 -3*w -1}
$$
{8 \  u \  v \  z \  x}+{{\left( {8 \  {w \sp 3}}+{4 \  {w \sp 2}}+{4 \  w} 
\right)}
\  t} -{8 \  {w \sp 4}} -{{12} \  {w \sp 3}} -{{14} \  {w \sp 2}} -{3 \  w} 
-1 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{p6 := 12*x*z*v**2+12*t*w**3 -12*w**4 +12*t*w**2 -18*w**3 +8*t*w -14*w**2 -w -1}
$$
{{12} \  {v \sp 2} \  z \  x}+{{\left( {{12} \  {w \sp 3}}+{{12} \  {w \sp 
2}}+{8 \  w} 
\right)}
\  t} -{{12} \  {w \sp 4}} -{{18} \  {w \sp 3}} -{{14} \  {w \sp 2}} -w -1 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{p7 := -24*t*w**3 + 24*w**4 - 24*t*w**2 + 36*w**3 - 8*t*w + 26*w**2 + 7*w + 1}
$$
{{\left( -{{24} \  {w \sp 3}} -{{24} \  {w \sp 2}} -{8 \  w} 
\right)}
\  t}+{{24} \  {w \sp 4}}+{{36} \  {w \sp 3}}+{{26} \  {w \sp 2}}+{7 \  w}+1 
$$
\returnType{Type: NewSparseMultivariatePolynomial(Integer,OrderedVariableList [b1,x,y,z,t,v,u,w])}

\spadcommand{lp := [p0, p1, p2, p3, p4, p5, p6, p7]}
$$
\begin{array}{@{}l}
\left[
{b1+y+z -t -w}, 
\right.
\\
\displaystyle
{{2 \  v \  y}+
{2 \  u \  z}+
{2 \  w \  t} -
{2 \  {w \sp 2}} -
