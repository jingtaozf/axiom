$$
{\left[ { \%B{53}}, { \%B{57}}, {-{ \%B{57}} -{4 \  { \%B{53}}}}, 
{ \%B{53}}, { \%B{53}}, { \%B{53}} 
\right]},\hbox{\hskip 3.5cm}
$$
$$
{\left[ { \%B{53}}, { \%B{58}}, {-{ \%B{58}} -{4 \  { \%B{53}}}}, 
{ \%B{53}}, { \%B{53}}, { \%B{53}} 
