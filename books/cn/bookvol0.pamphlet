\spadcommand{rest rest c  }
$$
\left[
y, y 
\right]
$$
\returnType{Type: Magma Symbol}

检查顺序

\spadcommand{ax:tree := a*x  }
$$
\left[
{\left[ x, x 
\right]},
x 
\right]
$$
