\opdata{{\mbox{\axiomFun{mantissa}}\opLeftPren{}{\it float}\opRightPren{}%
}%
}%
{1}{(\$)->Integer}{FloatingPointSystem}
{\smath{\mbox{\bf mantissa}\opLeftPren{}x\opRightPren{}} 
