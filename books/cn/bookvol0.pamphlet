\spadcommand{c::word }
$$
{x \sp 2} \  {y \sp 2} 
$$
\returnType{Type: OrderedFreeMonoid Symbol}

检查顺序

\spadcommand{a < b }
$$
{\tt true} 
$$
\returnType{Type: Boolean}

\spadcommand{a < c }
$$
{\tt true} 
$$
\returnType{Type: Boolean}

\spadcommand{b < c }
$$
{\tt true} 
$$
\returnType{Type: Boolean}

遍历这棵树

\spadcommand{first c }
$$
x 
$$
\returnType{Type: Symbol}

\spadcommand{rest c }
$$
\left[
x, {\left[ y, y 
\right]}
\right]
$$
