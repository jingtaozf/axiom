\opdata{{\mbox{\axiomFun{Ei}}\opLeftPren{}{\it variable}\opRightPren{}%
}%
}%
{1}{(\$)->\$}{LiouvillianFunctionCategory}
{\smath{\mbox{\bf Ei}\opLeftPren{}x\opRightPren{}} 
