\opdata{{\mbox{\axiomFun{one?}}\opLeftPren{}{\it element}\opRightPren{}%
}%
}%
{1}{(\$)->Boolean}{MonadWithUnit}
{\smath{\mbox{\bf one?}\opLeftPren{}a\opRightPren{}} 
tests whether \smath{a} is the unit 1.
}

