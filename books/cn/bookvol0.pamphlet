\opdata{{\mbox{\axiomFun{rule}}\opLeftPren{}{\it various}\opRightPren{}%
}%
}%
{2}{(F, F)->\$}{RewriteRule}
{Section \ref{ugUserRules} on page \pageref{ugUserRules}
}

