{{8820} \  {b \sp 4}}+
{{127050} \  {b \sp 3}}+
{{327000} \  {b \sp 2}}+
{{405200} \  b} -
{2062400}
\end{array}
\right)}{1339200} 
$$
\returnType{Type: AlgebraicNumber}

