{3 \  {b \sp 2} \  {a \sp 3} \  b \  {a \sp 2} \  b \  a}+
{{b \sp 2} \  {a \sp 3} \  b \  a \  b \  {a \sp 2}} 
\end{array}
$$
\returnType{Type: XDistributedPolynomial(Symbol,Fraction Integer)}

