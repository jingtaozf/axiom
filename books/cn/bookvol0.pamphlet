\opdata{{\mbox{\axiomFun{ruleset}}\opLeftPren{}
{\it listOfRules}\opRightPren{}%
}%
}%
{1}{(List(RewriteRule(Base, R, F)))->\$}{Ruleset}
{\smath{\mbox{\bf ruleset}\opLeftPren{}[r1, \allowbreak{} 
