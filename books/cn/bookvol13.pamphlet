\appendix

\chapter{全局环境}

设 $S$ 为一个集合。设 $\circ$ 为一个二元操作 (binary operation)。
设 $+$ 为一个加法操作。设 $*$ 为一个乘法操作。

\begin{axiom}[Magma]
{\bf Magma} 是配有一个 {\bf 封闭二元操作}
$S \circ S \rightarrow S$ 的集合 $S$,使得
\[\forall a,b \in S \Rightarrow a \circ b \in S\].
\end{axiom}

\begin{axiom}[半群]
{\bf 半群 (semigroup)} 是操作 $\circ$ {\bf 满足结合律} 的
{\bf Magma},使得
\[\forall a,b,c \in S \Rightarrow (a \circ b) \circ c = a \circ (b \circ c)\]
\end{axiom}

\begin{axiom}[Abelian 半群]
{\bf Abelian 半群} 是操作
$\circ$ {\bf 满足交换律} 的 {\bf 半群},使得
\[\forall a,b \in S \Rightarrow a \circ b = b \circ a\]
\end{axiom}

\begin{axiom}[幺半群]
{\bf 幺半群 (monoid)} 是带有一个 {\bf 单位元} $e \in S$ 的
{\bf 半群},使得
\[\forall a \in S \Rightarrow e \circ a = a \circ e = a\]
\end{axiom}

\begin{axiom}[群]
{\bf 群 (group)} 是带有一个 {\bf 逆元} $b \in S$
以及一个单位元 $i \in S$ 的
{\bf 幺半群},使得
\[\forall a \in S~\exists b \in S \Rightarrow a \circ b = b \circ a = i\]
\end{axiom}

\begin{axiom}[群的唯一单位元]
{\bf 群} 有一个 {\bf 唯一单位元} $e \in S$,使得
\[\exists e \land \forall a,b \in S \land a \ne e \land b \ne e \Rightarrow
a \circ b \ne e\]
\end{axiom}

\begin{axiom}[群的唯一逆元]
{\bf 群} 有一个 {\bf 唯一逆元} $i \in S$,使得
\[\exists i \land \forall a,b \in S \land a \ne i \land b \ne i \Rightarrow
a \circ b \ne i\]
\end{axiom}

\begin{axiom}[群的右商]
{\bf 群} 有一个 {\bf 右商}(右除法)运算,使得
\[x \circ a = b \Rightarrow x \circ a \circ a^{-1} = b \circ a^{-1}
\Rightarrow x = b \circ a^{-1}\]
\end{axiom}

\begin{axiom}[群的左商]
{\bf 群} 有一个 {\bf 左商}(左除法)运算,使得
\[a \circ x = b \Rightarrow a^{-1} \circ a \circ x = a^{-1} \circ b
\Rightarrow x = a^{-1} \circ b\]
\end{axiom}

\begin{axiom}[Abelian 群]
{\bf Abelian 群} 是操作 $\circ$
{\bf 满足交换律} 的 {\bf 群},使得
\[\forall a,b \in S \Rightarrow a \circ b = b \circ a\]
\end{axiom}

\begin{axiom}[Abelian 群的商]
{\bf Abelian 群} 有一个 {\bf 商}(除法)运算,使得
\[a^{-1} \circ a \circ x = a \circ a^{-1} \circ x\]
\end{axiom}



\begin{axiom}[Euclid 整环]
设 $R$ 为一个 {\bf 整环 (integral domain)}。设 $f$ 为一个从
$R\backslash \{0\}$ 到 NonNegativeInteger domain 的函数。
若 $a$ 与 $b$ 属于 $R$ 且 $b$ 非零,则存在
$q$ 与 $r$ 属于 $R$,使得 $a=bq+r$,且 $r=0$ 或
$f(r)<f(b)$ 二者之一成立
\end{axiom}

