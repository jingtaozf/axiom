\Maple       & [e, op(l)]     & [op(l), e]     & [op(l1), op(l2)] \\
\Mathematica & Prepend[l, e]  & Append[l, e]   & Join[l1, l2]     \\
\MuPAD       & [e, op(l)]     & append(l, e)   & l1 . l2          \\
\Octave      &                &                & \\
\Pari        &                &                & \\
