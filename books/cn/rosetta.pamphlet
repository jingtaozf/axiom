\begin{tabular}{l|lll}
& \h{\small 赋值（Assignment）} & \h{函数定义（Function definition）} & \h{清除变量与函数（Clear vars and funs）} \\
\hline
\Axiom       & y:= f(x)  & f(x, y) == x*y              &
	{\small\tt )clear properties y f} \\
\Derive      & y:= f(x)  & f(x, y):= x*y               & y:=  f:=           \\
\DoCon       &           &                             & \\
\GAP         & y:= f(x); & f:=function(x, y) return x*y; end; & \h{没有符号变量（There are no symbolic variables）}\\
\Gmp         &           &                             & \\
\Macsyma     & y: f(x);  & f(x, y):= x*y;              & remvalue(y)\$      \\
             &           &                             & remfunction(f)\$   \\
\Magnus      &           &                             & \\
\Maxima      & y: f(x);  & f(x, y):= x*y;              & remvalue(y)\$      \\
             &           &                             & remfunction(f)\$   \\
\Maple       & y:= f(x); & f:= proc(x, y) x*y end;     & y:= 'y':  f:= 'f': \\
